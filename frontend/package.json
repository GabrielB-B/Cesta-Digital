{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:showcase": "tsc -b && vite build --config vite.showcase.config.ts",
    "lint": "eslint .",
    "test:ui:font-scale": "node scripts/check-font-scale.mjs",
    "preview": "vite preview",
    "showcase": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "test:e2e": "playwright test",
    "test:visual:foundation": "playwright test --config=playwright.showcase.config.ts",
    "test:visual:shell": "playwright test --config=playwright.shell.config.ts",
    "test:visual:login": "playwright test --config=playwright.login.config.ts",
    "test:visual:dashboard": "playwright test --config=playwright.dashboard.config.ts",
    "test:visual:families": "playwright test --config=playwright.families.config.ts",
    "test:visual:assessments": "playwright test --config=playwright.assessments.config.ts",
    "test:visual:stock": "playwright test --config=playwright.stock.config.ts",
    "test:visual:entries": "playwright test --config=playwright.entries.config.ts",
    "test:visual:deliveries": "playwright test --config=playwright.deliveries.config.ts",
    "test:visual:baskets": "playwright test --config=playwright.baskets.config.ts",
    "test:visual:reports": "playwright test --config=playwright.reports.config.ts",
    "test:visual:administration": "playwright test --config=playwright.administration.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.2.7",
    "@fontsource-variable/sora": "^5.2.8",
    "axios": "^1.16.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}

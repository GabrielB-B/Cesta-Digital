APP_ENV=staging
LOG_LEVEL=INFO
FRONTEND_CORS_ORIGINS=https://cesta-digital.vercel.app
BOOTSTRAP_ADMIN_ENABLED=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cesta_digital_staging
DB_USER=staging_user
DB_PASSWORD=change_me

FIRST_ADMIN_NAME=Administrador
FIRST_ADMIN_LOGIN_NAME=admin
FIRST_ADMIN_EMAIL=admin@cestadigital.app
FIRST_ADMIN_PASSWORD=Troque-esta-senha!

SECRET_KEY=replace-with-a-long-random-secret-with-32-plus-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=cesta_digital_session
AUTH_COOKIE_SAMESITE=none
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900

EXTREME_POVERTY_MAX_INCOME_PER_CAPITA=109
POVERTY_MAX_INCOME_PER_CAPITA=218

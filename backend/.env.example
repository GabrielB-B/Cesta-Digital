APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BOOTSTRAP_ADMIN_ENABLED=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cesta_digital
DB_USER=root
DB_PASSWORD=change_me
DB_SSL_REQUIRED=false
DB_SSL_CA=

FIRST_ADMIN_NAME=Administrador
FIRST_ADMIN_LOGIN_NAME=admin
FIRST_ADMIN_EMAIL=admin@cestadigital.app
FIRST_ADMIN_PASSWORD=Admin@123456

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=cesta_digital_session
AUTH_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900

EXTREME_POVERTY_MAX_INCOME_PER_CAPITA=109
